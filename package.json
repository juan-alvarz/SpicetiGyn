{
  "name": "nordlys",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "build:test": "tsx tools/build.ts --with-test-assets",
    "dev": "tsx tools/dev.ts",
    "new:theme": "tsx tools/new-theme.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:boundaries": "tsx tools/check-boundaries.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:test && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm build",
    "changeset": "changeset",
    "version": "changeset version && biome format --write .",
    "release": "tsx tools/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
